HELPDESK_URL=
HELPDESK_KEY=
CANDIDATE_EMAIL=
CANDIDATE_NAME=
LLM_API_KEY=
# Model. Leave LLM_PROVIDER empty to run with rules only (dry-run only).
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-5-5
LLM_VIEW_MODEL=
# Room for the model's thinking plus the form. A cut-off answer becomes a handoff.
LLM_MAX_TOKENS=4000
CONFIDENCE_THRESHOLD=0.75
SPEND_CAP_EUR=0.25
